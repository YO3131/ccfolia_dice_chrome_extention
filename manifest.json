{
  "manifest_version": 3,
  "name": "ccfolia dice extention",
  "version": "1.1",
  "description": "ココフォリアにダイスを拡張する",
  "content_scripts": [
    {
      "matches": ["https://ccfolia.com/rooms/*"],
      "js": ["main.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["1d2.png", "1d3.png"],
      "matches": ["https://ccfolia.com/*"]
    }
  ]
}