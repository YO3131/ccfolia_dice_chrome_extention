{
  "manifest_version": 3,
  "name": "ccfolia dice extention",
  "version": "1.4",
  "description": "ココフォリアにダイスを拡張する",
  "content_scripts": [
    {
      "matches": ["https://ccfolia.com/rooms/*"],
      "js": [
        "dom.js",
        "dice.js",
        "event.js",
        "button.js",
        "contents.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources":  ["images/*"],
      "matches": ["https://ccfolia.com/*"]
    }
  ]
}